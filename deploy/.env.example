# Production settings for deploy/compose.yml: cp deploy/.env.example deploy/.env
# deploy/.env holds secrets: keep it out of git (it is ignored) and readable only by the deployer.

# --- Required ---

# The address people open, with no trailing slash. Must be https:// (the session cookie is
# Secure). Google's OAuth client needs <PUBLIC_URL>/api/auth/google/callback as a redirect URI.
PUBLIC_URL=https://feedback.example.com

# Shown in the UI.
PROGRAM_NAME="Your Program"
ORG_NAME="Your Organisation"

# The bundled database's password. Use letters and digits only (it goes into a URL), for
# example from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Google sign-in (README → "Google sign-in").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---

# The first admin, made by the seed job when no active admin exists.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_NAME="Your Name"

# Intern photos (Cloudinary's "API environment variable").
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
# CLOUDINARY_FOLDER=feedback-portal/interns

# A database outside the stack instead of the bundled one.
# DATABASE_URL=postgres://user:password@host:5432/feedback_portal

# Images: pulled from IMAGE_REGISTRY (e.g. registry.example.com/team/) at IMAGE_TAG, or built
# here with --build. Tag each release (e.g. the git commit) so you can roll back to it.
# IMAGE_REGISTRY=
# IMAGE_TAG=latest

# Where the web container listens: loopback for a TLS proxy on this host (default), or 0.0.0.0
# for a load balancer elsewhere. With a load balancer, list its addresses (CIDRs, comma-separated)
# in TRUSTED_PROXIES so sessions record the client's IP, not the balancer's.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080
# TRUSTED_PROXIES=10.0.0.0/8

# Telemetry, sent to any OTLP/HTTP backend (Grafana Cloud, Honeycomb, a collector). The api:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
# Browser traces too: a collector the web container can reach, and a rebuild of the web image.
# OTLP_UPSTREAM=collector:4318
# WEB_OTEL_TRACES_URL=/otlp/v1/traces

# LOG_LEVEL=info
