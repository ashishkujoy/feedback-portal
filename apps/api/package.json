{
  "name": "@feedback-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/shared/db/migrate.cli.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "test:int": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@feedback-portal/contracts": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@logtape/logtape": "2.3.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.11",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@feedback-portal/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "vitest": "5.0.2"
  }
}
