{
  "name": "@feedback-portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/shared/db/migrate.cli.ts",
    "db:seed": "node --env-file-if-exists=.env src/modules/identity/bootstrap-admin.cli.ts",
    "dev": "node --env-file-if-exists=.env --import ./src/instrumentation.ts --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --import ./src/instrumentation.ts src/main.ts",
    "test": "vitest run",
    "test:int": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@feedback-portal/contracts": "workspace:*",
    "@hono/node-server": "2.1.3",
    "@logtape/logtape": "2.3.10",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.11",
    "import-in-the-middle": "3.5.2",
    "pg": "8.23.1",
    "uuid": "14.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@feedback-portal/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1",
    "vitest": "5.0.2"
  }
}
