# Copy to .env for local development: cp .env.example .env
# In Docker/production these come from the real environment.

# development | test | production (default: development)
NODE_ENV=development

# HTTP server (defaults: 0.0.0.0 / 3000)
HOST=0.0.0.0
PORT=3000

# Logging (defaults: info / json). pretty = coloured, human-readable output for local dev.
LOG_LEVEL=info
LOG_FORMAT=pretty

# Postgres — required. Local-only credentials matching docker-compose.yml (host port 5433).
DATABASE_URL=postgres://feedback:feedback@localhost:5433/feedback_portal
# Connection pool size (default: 10)
DATABASE_POOL_MAX=10

# Branding — required, no defaults. Shown in the UI.
PROGRAM_NAME="Your Program"
ORG_NAME="Your Organisation"
