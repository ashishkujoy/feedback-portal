# Copy to .env for local development: cp .env.example .env
# In Docker/production these come from the real environment.

# development | test | production (default: development)
NODE_ENV=development

# HTTP server (defaults: 0.0.0.0 / 3000)
HOST=0.0.0.0
PORT=3000

# Logging (defaults: info / json). pretty = coloured, human-readable output for local dev.
LOG_LEVEL=info
LOG_FORMAT=pretty

# Postgres — required. Local-only credentials matching docker-compose.yml (host port 5433).
DATABASE_URL=postgres://feedback:feedback@localhost:5433/feedback_portal
# Connection pool size (default: 10)
DATABASE_POOL_MAX=10

# Branding — required, no defaults. Shown in the UI.
PROGRAM_NAME="Your Program"
ORG_NAME="Your Organisation"

# Google sign-in — optional locally. Without the ID and secret, /auth/google* answers 503.
# See README → "Google sign-in" for creating the OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must match an authorised redirect URI of the OAuth client (default shown).
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Where the browser goes after signing in; failures go to <WEB_APP_URL>/login (default: Vite).
WEB_APP_URL=http://localhost:5173

# First admin — read only by `pnpm db:seed` (and the Compose `seed` job). When no active admin
# exists, the seed makes this email an active admin; sign in with that Google account.
# The name defaults to the part of the email before @.
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_NAME="Your Name"

# OpenTelemetry — off unless an OTLP/HTTP endpoint is set. Uncomment to send `pnpm dev`
# telemetry to Grafana LGTM from docker-compose (Grafana at http://localhost:3001).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=feedback-portal-api
# OTEL_METRIC_EXPORT_INTERVAL=60000
# OTEL_SDK_DISABLED=false
