{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "overrides": [
    {
      "files": ["apps/web/**/*.tsx", "apps/web/**/*.ts"],
      "options": { "sortTailwindcss": { "stylesheet": "./apps/web/src/styles.css" } }
    }
  ],
  "ignorePatterns": ["pnpm-lock.yaml", "**/dist/**", "**/coverage/**", "**/*.md"]
}
